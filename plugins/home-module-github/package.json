{
  "name": "@alaborderie/backstage-plugin-home-module-github",
  "version": "0.1.0",
  "description": "GitHub open issues and pull requests widgets for the Backstage home page.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/alaborderie/backstage-ember",
    "directory": "plugins/home-module-github"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.esm.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
